# =====================================================================
# DMC Contingencia · plantilla de variables de entorno
# ---------------------------------------------------------------------
# Único archivo .env versionado (ver .gitignore). Es documentación:
# NO pongas credenciales, hosts ni secretos reales aquí.
#
# Local:
#     cp .env.example .env.development     # y rellena los valores
#     npm run secreto                      # genera SESSION_SECRET
#
# Producción (Vercel u otro): estas variables se definen en el panel de
# entorno del despliegue, no en un archivo. Las variables del sistema
# tienen precedencia sobre cualquier .env*.
#
# Todas se leen server-side (lib/env.ts, lib/db/config.ts). NINGUNA debe
# llevar prefijo NEXT_PUBLIC_: eso las publicaría en el bundle del
# navegador junto con la contraseña de la base de datos.
# =====================================================================

# --- Sesión ----------------------------------------------------------

# OBLIGATORIA. Clave con la que se firma la cookie de sesión (HMAC-SHA256).
# Mínimo 32 caracteres. Genérala con `npm run secreto`.
# Cambiarla invalida todas las sesiones abiertas.
SESSION_SECRET=

# --- Conexión a SQL Server -------------------------------------------
#
# Ya no hay modo de demostración: TODA la aplicación (login, visitas,
# maestros y checklist) lee y escribe en SQL Server. Sin estas cuatro
# variables la app no arranca.

# Host o IP de la instancia. Para instancia con nombre, usa solo el host
# aquí y el puerto TCP en DB_PORT: el driver tedious no resuelve
# `HOST\INSTANCIA` sin el SQL Browser.
DB_SERVER=

# Puerto TCP. Default: 1433.
DB_PORT=1433

# Nombre de la base de datos.
DB_NAME=

# Autenticación SQL. Usa una cuenta con permisos solo sobre el esquema
# `dmc`, nunca `sa`.
DB_USER=
DB_PASSWORD=

# --- TLS de la conexión ----------------------------------------------

# Cifrado del canal. Default: true. En producción es obligatorio: con
# false la contraseña viajaría en claro y el arranque aborta.
DB_ENCRYPT=true

# true = acepta CUALQUIER certificado del servidor. Necesario en local
# porque SQL Server genera uno autofirmado.
# En producción debe ser false: con true el canal va cifrado pero no se
# valida contra quién se habla, y queda expuesto a man-in-the-middle.
DB_TRUST_SERVER_CERT=false

# --- Pool y tiempos de espera ----------------------------------------

# Conexiones máximas por instancia. En serverless cada instancia abre su
# propio pool, así que conviene un número bajo (2-4). Default: 4.
DB_POOL_MAX=4

# Milisegundos antes de rendirse. Defaults: 15000 ambos.
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000

# --- Diagnóstico -----------------------------------------------------

# Habilita GET /api/salud, que reporta si la app llega a la base de datos
# y si los catálogos están sembrados. Sin esta variable la ruta responde
# 404. Genérala con `npm run secreto`.
#   curl -H "Authorization: Bearer <token>" https://<app>/api/salud
HEALTHCHECK_TOKEN=

# --- Reserva del acta (solo desarrollo) -------------------------------

# Cuando los dos técnicos de una visita abren el acta, el primero la reserva
# y la reserva vence tras 15 minutos sin actividad. Para probar el
# vencimiento sin esperar, acórtalo aquí (segundos, entre 5 y 900). En
# producción se ignora: siempre son 15 minutos. NO la definas en Vercel.
# RESERVA_PLAZO_SEG=60

# --- Web Push (avisos con el navegador cerrado) -----------------------
# OPCIONALES. Sin ellas la campanita sigue funcionando (aviso y sonido con
# el panel abierto); solo no llegan avisos con el navegador cerrado.
# Genera el par con:
#     node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"
# La privada es un secreto de servidor. No cambiarlas después: las
# suscripciones ya hechas dejarían de servir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un mailto: o https: de contacto, que ven los servicios de push.
VAPID_SUBJECT=

# --- Correo (enviar el acta desde la visita) ---------------------------
# OPCIONALES. Sin ellas el botón «Enviar por correo» avisa que el correo no
# está configurado y no manda nada. Proveedor: Resend (https://resend.com),
# por su API HTTP; no hace falta instalar nada.
#
# El acta sale con el correo con que inició sesión quien la envía, siempre que
# su dominio esté verificado en Resend; las respuestas le llegan a esa persona.
#
# 1. Crea la cuenta y verifica el dominio de los correos del equipo (Domains →
#    registros SPF/DKIM en el DNS). Sin dominio verificado solo se puede
#    mandar a tu propio correo.
# 2. API Keys → Create → permiso «Sending access». Es un secreto de servidor:
#    nunca con prefijo NEXT_PUBLIC_.
RESEND_API_KEY=
# Remitente de respaldo, para quien inicia sesión con un correo de otro dominio
# (p. ej. gmail.com). Su nombre visible también se usa con el correo de cada
# persona. Tiene que ser de un dominio verificado.
#   CORREO_REMITENTE="Grupo dMC <actas@tudominio.cl>"
CORREO_REMITENTE=
# Otros dominios verificados en Resend, separados por coma. El de
# CORREO_REMITENTE ya cuenta. Opcional.
#   CORREO_DOMINIOS=tudominio.cl,otrodominio.cl
CORREO_DOMINIOS=

# --- Avisos por correo (lo de la campanita, también por correo) ---------
# APAGADO mientras AVISOS_CORREO_ACTIVO no sea true. Apagado, la app se
# comporta como antes: no encola nada, no muestra «Avisos» en «Mi cuenta» y el
# push sigue al nivel «Avisar» de la campanita.
#
# Para encenderlo:
#   1. Aplica sql/migracion-043-avisos-por-correo.sql.
#   2. Verifica en Resend el (sub)dominio del remitente de avisos.
#   3. Define las variables de abajo, más RESEND_API_KEY.
#   4. Programa el cron (ver CRON_SECRET) y redespliega.
AVISOS_CORREO_ACTIVO=false
# Remitente de los avisos, de un dominio verificado en Resend. Si falta, se
# usa CORREO_REMITENTE.
#   CORREO_AVISOS_REMITENTE="Grupo dMC · Avisos <avisos@avisos.tudominio.cl>"
CORREO_AVISOS_REMITENTE=
# Dirección pública de la app, para los enlaces del correo. Sin barra final.
#   APP_URL=https://visitas.tudominio.cl
APP_URL=
# Secreto con que el programador llama a GET /api/cron/correos (Vercel lo
# manda solo como «Authorization: Bearer <CRON_SECRET>»). Sin él la ruta
# responde 404. Genéralo con `npm run secreto`. Programa la ruta cada 10
# minutos (Vercel Pro) o, en el plan Hobby, una vez al día a la hora del
# resumen: lo agrupado «al momento» igual sale con el siguiente evento.
CRON_SECRET=
